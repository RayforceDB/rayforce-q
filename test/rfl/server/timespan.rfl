;; Server timespan round trip: our client (.q.send) -> our server. Skipped by
;; test/run.sh when the core has no TIMESPAN (Q_HAVE_TIMESPAN is 0).
(set h (.q.connect qhost qport))

;; timespan atom / vector / null / table column (wire type 16)
(.q.send h "0D01:02:03.000000004") -- 0D01:02:03.000000004
(.q.send h "[0D00:00:01 0D00:00:02]") -- [0D00:00:01.000000000 0D00:00:02.000000000]
(.q.send h "(- 2024.01.02D10:00:00.000000000 2024.01.02D09:00:00.000000000)") -- 0D01:00:00.000000000
(nil? (.q.send h "0Nn")) -- true
(nil? (at (.q.send h "[0D00:00:01 0Nn]") 1)) -- true
(.q.send h "(table [a b] (list [1 2] [0D00:00:01 0D00:00:02]))") -- (table [a b] (list [1 2] [0D00:00:01 0D00:00:02]))

(.q.close h)
